# copie este arquivo para .env e troque pelas suas connection strings
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/
# Redis Cloud: Connect > Redis Client > copie a URL (redis://default:senha@host:porta)
REDIS_URL=redis://default:senha@redis-12345.c1.us-east-1-1.ec2.redns.redis-cloud.com:12345
